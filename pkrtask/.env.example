# Local development. On the server these come from /etc/scrimmage/pkrtask.env.
DATABASE_PATH=./data/pkrtask.sqlite3
# The scrimmage Flask app (run with AUTH_MODE=dev; see the repo README).
SCRIMMAGE_INTERNAL_URL=http://127.0.0.1:8000
# Where browsers reach the site; scrimmage's /login is under it.
PUBLIC_URL=http://localhost:3000
