[Unit]
Description=Pokerbots scrimmage web app (gunicorn)
After=network.target

[Service]
User=scrimmage
Group=scrimmage
EnvironmentFile=/etc/scrimmage/env
EnvironmentFile=-/etc/scrimmage/env.local
WorkingDirectory=/opt/scrimmage
RuntimeDirectory=scrimmage
RuntimeDirectoryMode=0750
UMask=0077
ExecStart=/opt/scrimmage/.venv/bin/gunicorn \
    --bind unix:/run/scrimmage/web.sock --umask 0007 \
    --workers 3 --threads 4 --worker-class gthread \
    --timeout 600 --graceful-timeout 30 --max-requests 5000 --max-requests-jitter 500 \
    --access-logfile - --access-logformat '%(h)s "%(r)s" %(s)s %(b)s %(M)sms' \
    'scrimmage.web:create_app()'
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/scrimmage
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
